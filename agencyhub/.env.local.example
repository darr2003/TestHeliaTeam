# =============================================================================
# AgencyHub — Variables de Entorno
# Copiar como .env.local y completar con valores reales
# =============================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Database (PostgreSQL via Supabase) ---
# DATABASE_URL va por el pooler (pgbouncer). DIRECT_URL es la conexion directa y
# es obligatoria: Prisma la usa para migraciones, y los scripts de seed tienen que
# apuntar a ella o fallan contra el pooler. Las dos son necesarias.
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# --- Encriptación de tokens de API ---
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Meta Ads ---
META_APP_ID=
META_APP_SECRET=

# --- Google Ads ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Sync ---
SYNC_API_KEY=
CRON_SECRET=

# --- Feature flags ---
# Modulo de control de gasto: dashboard, presupuestos, conexiones, alarmas,
# reportes y tipo de cambio. Apagado por defecto. Prender solo cuando las
# conexiones a Meta y Google esten validadas.
FEATURE_SPEND=false

# --- Agente de competencia ---
# Secreto compartido con el agente externo. Autentica tanto POST /api/informes/ingest
# como GET /api/clientes/activos. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_API_KEY=

# --- R2 (almacenamiento de informes) ---
# Opcional. Si falta cualquiera de las cuatro, los informes se guardan inline en
# la columna reports.content y la app funciona igual. Los informes ya guardados
# se siguen leyendo de donde esten, asi que prender R2 despues no migra nada.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
